
{
  "entities": {
    "Distributor": {
      "title": "Distributor",
      "description": "A member of the MLM network.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "referralCode": { "type": "string", "description": "Legacy field removed by migration." },
        "leftReferralCode": { "type": "string" },
        "rightReferralCode": { "type": "string" },
        "sponsorId": { "type": "string" },
        "sponsorChildIds": { "type": "array", "items": { "type": "string" } },
        "parentId": { "type": "string" },
        "position": { "type": "string", "enum": ["left", "right"] },
        "leftChildId": { "type": "string" },
        "rightChildId": { "type": "string" },
        "packageId": { "type": "string" },
        "rank": { "type": "string" },
        "kycStatus": { "type": "string", "enum": ["none", "pending", "verified", "rejected"] },
        "leftCount": { "type": "number" },
        "rightCount": { "type": "number" },
        "leftBV": { "type": "number" },
        "rightBV": { "type": "number" },
        "incentiveBalance": { "type": "number" },
        "shoppingBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive", "pending_confirmation"] },
        "enrollmentType": { "type": "string", "enum": ["self", "assisted"] },
        "enrolledBy": { "type": "string" },
        "ancestorIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "leftReferralCode", "rightReferralCode"]
    },
    "Package": {
      "title": "Package",
      "description": "MLM entry packages.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "bvCredited": { "type": "number" },
        "active": { "type": "boolean" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Physical items in the e-commerce catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "bvValue": { "type": "number" },
        "stock": { "type": "number" },
        "images": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "storagePath": { "type": "string" },
              "isPrimary": { "type": "boolean" },
              "order": { "type": "number" }
            }
          } 
        },
        "status": { "type": "string", "enum": ["active", "inactive", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial records of package purchases and payouts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "distributorId": { "type": "string" },
        "packageId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["created", "paid", "failed", "refunded"] },
        "enrolledBy": { "type": "string" },
        "razorpayOrderId": { "type": "string" },
        "razorpayPaymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "failureReason": { "type": "string" }
      }
    },
    "KYCSubmission": {
      "title": "KYC Submission",
      "description": "Member identity verification data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "distributorId": { "type": "string" },
        "sponsorId": { "type": "string" },
        "submittedBy": { "type": "string", "enum": ["self", "sponsor"] },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "idProofUrl": { "type": "string" },
        "addressProofUrl": { "type": "string" },
        "selfieUrl": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/distributors/{distributorId}": {
      "schema": "Distributor",
      "description": "Main distributor profiles."
    },
    "/packages/{packageId}": {
      "schema": "Package",
      "description": "Available entry packages."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Inventory and e-commerce products."
    },
    "/kycSubmissions/{submissionId}": {
      "schema": "KYCSubmission",
      "description": "Member identity verification data."
    },
    "/referralCodes/{code}": {
      "schema": {
        "type": "object",
        "properties": {
          "ownerId": { "type": "string" },
          "ownerName": { "type": "string" },
          "ownerKycStatus": { "type": "string" },
          "ownerRank": { "type": "string" },
          "treeRootId": { "type": "string" },
          "position": { "type": "string", "enum": ["left", "right"] }
        }
      },
      "description": "Fast lookup for referral codes."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial ledger for the platform."
    }
  }
}
