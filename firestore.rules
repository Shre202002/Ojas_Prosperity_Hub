
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Robust admin check: allows the hardcoded email or anyone with Admin rank
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sriyanshgupta24@gmail.com' ||
        (exists(/databases/$(database)/documents/distributors/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/distributors/$(request.auth.uid)).data.rank == 'Admin')
      );
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Distributors collection
    match /distributors/{distributorId} {
      // allow get is needed for referral lookups and profile viewing
      allow get: if true;

      // list queries are allowed for all members to support genealogy tree navigation
      allow list: if isSignedIn();
      
      // Allow creation for new signups
      allow create: if isSignedIn(); 
      
      // Admin or Owner can update
      allow update: if isOwner(distributorId) || isSuperAdmin();
      
      // Only admin can delete
      allow delete: if isSuperAdmin();
    }

    // Pending Enrollments (Assisted Flow)
    match /pendingEnrollments/{email} {
      // Allow lookup by email for setup-account flow
      allow get: if true;
      allow read: if isSignedIn() && (request.auth.token.email.lower() == email.lower() || isSuperAdmin());
      allow write: if isSignedIn();
    }

    // Packages collection
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Referral Codes lookup
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // KYC Submissions
    match /kycSubmissions/{submissionId} {
      allow create: if isSignedIn();
      
      // Allow listing for members and admins
      allow list: if isSignedIn();
      
      // Specific read access for owner, sponsor, and admin
      allow get: if isSignedIn() && (
        resource.data.distributorId == request.auth.uid || 
        resource.data.sponsorId == request.auth.uid || 
        isSuperAdmin()
      );
      
      // Sponsor can review, Admin can do anything
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.sponsorId == request.auth.uid)
      );
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Allow single doc read for everyone (needed for registration polling)
      allow get: if true;

      // Allow listing for owner, enroller, or admin
      allow list: if isSignedIn();
      
      allow create: if isSignedIn(); 
      allow update: if isSuperAdmin();
    }
    
    // Users fallback for standard profile data
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }
  }
}
