
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sriyanshgupta24@gmail.com' ||
        get(/databases/$(database)/documents/distributors/$(request.auth.uid)).data.rank == 'Admin'
      );
    }

    function isVerifiedDistributor() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/distributors/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/distributors/$(request.auth.uid)).data.kycStatus == 'verified';
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Distributors collection
    match /distributors/{distributorId} {
      allow read: if isSignedIn() && (isOwner(distributorId) || isSuperAdmin() || 
        request.auth.uid in get(/databases/$(database)/documents/distributors/$(distributorId)).data.ancestorIds);
      
      // Super Admin can read all distributors
      allow read: if isSuperAdmin();
      
      // Admin or Owner can update, but critical tree fields are protected for non-admins
      allow update: if (isOwner(distributorId) || isSuperAdmin()) && 
        (isSuperAdmin() || !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['parentId', 'leftChildId', 'rightChildId', 'leftCount', 'rightCount', 'rank', 'sponsorId']));
      
      allow create: if isSignedIn(); 
    }

    // Pending Enrollments (Assisted Flow)
    match /pendingEnrollments/{email} {
      allow read: if isSignedIn() && (request.auth.token.email.lower() == email.lower() || isSuperAdmin());
      allow write: if isVerifiedDistributor() || isSuperAdmin();
    }

    // Packages collection
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Referral Codes lookup
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // KYC Submissions
    match /kycSubmissions/{submissionId} {
      // Distributor can manage their own
      allow read, create: if isSignedIn() && (request.resource.data.distributorId == request.auth.uid || request.resource.data.distributorId == request.auth.token.email.lower());
      
      // Sponsor can review
      allow read: if isSignedIn() && resource.data.sponsorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.sponsorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason']);
        
      allow read, write: if isSuperAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Allow single doc read for everyone (needed for registration polling before account creation)
      allow get: if true;

      // Owners can query their own transactions
      allow list: if isSignedIn() && (resource.data.distributorId == request.auth.uid || resource.data.enrolledBy == request.auth.uid);
      
      // Super Admin can read and update (for refunds/audit) all transactions
      allow read, update: if isSuperAdmin();
      
      // Mutations to status/payment details should generally be Cloud Function/Admin SDK only
      allow create: if isSignedIn(); 
    }
    
    // Users fallback for standard profile data
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }
  }
}
