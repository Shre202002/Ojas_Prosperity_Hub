
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sriyanshgupta24@gmail.com' ||
        (exists(/databases/$(database)/documents/distributors/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/distributors/$(request.auth.uid)).data.rank == 'Admin')
      );
    }

    function isVerifiedDistributor() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/distributors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/distributors/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/distributors/$(request.auth.uid)).data.kycStatus == 'verified';
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Distributors collection
    match /distributors/{distributorId} {
      // allow get is needed for referral lookups during unauthenticated registration
      allow get: if true;

      // list queries are restricted to authorized users or admins
      // This allows filtering by sponsorId or parentId in tree views
      allow list: if isSignedIn();
      
      // Admin or Owner can update, but critical tree fields are protected for non-admins
      allow update: if (isOwner(distributorId) || isSuperAdmin()) && 
        (isSuperAdmin() || !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['parentId', 'leftChildId', 'rightChildId', 'leftCount', 'rightCount', 'rank', 'sponsorId']));
      
      allow create: if isSignedIn(); 
    }

    // Pending Enrollments (Assisted Flow)
    match /pendingEnrollments/{email} {
      allow read: if isSignedIn() && (request.auth.token.email.lower() == email.lower() || isSuperAdmin());
      allow write: if isVerifiedDistributor() || isSuperAdmin();
    }

    // Packages collection
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Referral Codes lookup
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // KYC Submissions
    match /kycSubmissions/{submissionId} {
      // Allow creation if self or sponsor
      allow create: if isSignedIn();
      
      // Allow read/list for owner, sponsor, or admin
      allow read: if isSignedIn() && (
        resource.data.distributorId == request.auth.uid || 
        resource.data.distributorId == request.auth.token.email.lower() ||
        resource.data.sponsorId == request.auth.uid || 
        isSuperAdmin()
      );
      
      // Sponsor can review, Admin can do anything
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.sponsorId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason']))
      );
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Allow single doc read for everyone (needed for registration polling before account creation)
      allow get: if true;

      // Allow listing for owner, enroller, or admin
      allow list: if isSignedIn() && (
        resource.data.distributorId == request.auth.uid || 
        resource.data.enrolledBy == request.auth.uid || 
        isSuperAdmin()
      );
      
      allow update: if isSuperAdmin();
      allow create: if isSignedIn(); 
    }
    
    // Users fallback for standard profile data
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }
  }
}
