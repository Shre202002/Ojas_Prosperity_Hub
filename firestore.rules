rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/distributors/$(request.auth.uid)).data.rank == 'Admin';
    }

    // Distributors collection
    match /distributors/{distributorId} {
      allow read: if isSignedIn();
      // Only server/admin can update critical tree fields
      allow update: if isOwner(distributorId) && 
        !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['parentId', 'leftChildId', 'rightChildId', 'leftCount', 'rightCount', 'rank']);
      allow create: if isSignedIn(); 
    }

    // Packages collection
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Referral Codes lookup
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // KYC Submissions
    match /kycSubmissions/{submissionId} {
      // Distributor can read and create their own
      allow read, create: if isSignedIn() && request.resource.data.distributorId == request.auth.uid;
      
      // Sponsor can read and update status for their referrals
      allow read: if isSignedIn() && resource.data.sponsorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.sponsorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason']);
        
      allow read, write: if isAdmin();
    }
    
    // Users fallback for standard profile data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}